# Copy to .env for local development outside docker-compose.
# All values have working defaults for the compose stack (see app/settings.py).
SO_DATABASE_URL=postgresql+asyncpg://second_opinion:second_opinion@localhost:5432/second_opinion
SO_REDIS_URL=redis://localhost:6379/0
SO_S3_ENDPOINT_URL=http://localhost:9100
SO_S3_ACCESS_KEY=minioadmin
SO_S3_SECRET_KEY=minioadmin
SO_S3_BUCKET=recordings

# Speech stage: "sarvam" (real Batch API, needs key) or "fake" (canned segments)
SO_SPEECH_PROVIDER=fake
SO_SARVAM_API_KEY=

# NLP stage: "sarvam" (sarvam-105b chat, needs key) or "fake" (canned weights/extraction)
SO_NLP_PROVIDER=fake

# Assessment stage: "sarvam" (sarvam-105b chat, needs key) or "fake" (canned triage output)
SO_ASSESSMENT_PROVIDER=fake
SO_SARVAM_MODEL=saaras:v3
SO_SARVAM_CHAT_MODEL=sarvam-105b
SO_SARVAM_ASSESSMENT_MODEL=sarvam-105b

# Worker retries: initial attempt + 3 retries, exponential backoff with bounded jitter
SO_WORKER_MAX_RETRIES=3
SO_WORKER_RETRY_BACKOFF_SECONDS=30
SO_WORKER_RETRY_BACKOFF_MAX_SECONDS=900
SO_WORKER_RETRY_JITTER_SECONDS=15
