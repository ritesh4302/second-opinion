# Copy to .env for local development outside docker-compose.
# All values have working defaults for the compose stack (see app/settings.py).
SO_DATABASE_URL=postgresql+asyncpg://second_opinion:second_opinion@localhost:5432/second_opinion
SO_REDIS_URL=redis://localhost:6379/0
SO_S3_ENDPOINT_URL=http://localhost:9100
SO_S3_ACCESS_KEY=minioadmin
SO_S3_SECRET_KEY=minioadmin
SO_S3_BUCKET=recordings

# Speech stage: "sarvam" (real Batch API, needs key) or "fake" (canned segments)
SO_SPEECH_PROVIDER=sarvam
SO_SARVAM_API_KEY=sk_alvdj0m2_ck8gof6nyehSiB7ie82VoFqh

# NLP stage: "sarvam" (sarvam-m chat, needs key) or "fake" (canned weights/extraction)
SO_NLP_PROVIDER=sarvam
