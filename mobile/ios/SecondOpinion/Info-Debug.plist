<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Debug-only variant of Info.plist (selected by Config/Debug.xcconfig):
	     identical except for the ATS local-networking exception below.
	     Keep the two files in sync when adding keys. -->
	<!-- Injected from the BACKEND_BASE_URL build setting; read by AppConfig. -->
	<key>BackendBaseURL</key>
	<string>$(BACKEND_BASE_URL)</string>
	<!-- Consent gate (DPDP): telemetry collection is off until the pharmacist
	     accepts the current legal version; TelemetryController then enables it. -->
	<key>FirebaseAnalyticsCollectionEnabled</key>
	<false/>
	<key>FirebaseCrashlyticsCollectionEnabled</key>
	<false/>
	<!-- Upload-queue background processing (UploadBackgroundScheduler). -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>org.charged-proton.secondopinion.upload-queue</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
	</array>
	<!-- Debug talks to the docker-compose stack over plain http://127.0.0.1:8000. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
