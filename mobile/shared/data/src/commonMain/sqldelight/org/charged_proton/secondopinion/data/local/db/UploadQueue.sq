CREATE TABLE upload_queue (
    case_id TEXT NOT NULL,
    owner_id TEXT NOT NULL,
    state TEXT NOT NULL,
    pipeline_stage TEXT,
    last_error TEXT,
    attempt_count INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY(case_id, owner_id)
);

selectQueue:
SELECT * FROM upload_queue
WHERE case_id = ? AND owner_id = ?;

selectPendingByOwner:
SELECT * FROM upload_queue
WHERE owner_id = ? AND state IN ('ENQUEUED', 'UPLOADING', 'PROCESSING', 'RETRY_WAIT');

insertQueue:
INSERT OR IGNORE INTO upload_queue(case_id, owner_id, state)
VALUES (?, ?, 'ENQUEUED');

resetFailedQueue:
UPDATE upload_queue
SET state = 'ENQUEUED', pipeline_stage = NULL, last_error = NULL
WHERE case_id = ? AND owner_id = ? AND state = 'FAILED';

updateQueue:
UPDATE upload_queue
SET state = ?, pipeline_stage = ?, last_error = ?, attempt_count = ?
WHERE case_id = ? AND owner_id = ?;

deleteQueue:
DELETE FROM upload_queue
WHERE case_id = ? AND owner_id = ?;